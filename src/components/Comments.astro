---
// Utterances 评论：基于 GitHub Issues，零后台、零数据库
interface Props {
  repo?: string;
}
const { repo = 'na57/na57.github.io' } = Astro.props;
---

<section class="comments">
  <script
    is:inline
    async
    src="https://utteranc.es/client.js"
    repo={repo}
    issue-term="pathname"
    theme="github-light"
    crossorigin="anonymous"
  >
  </script>
</section>
