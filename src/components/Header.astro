---
// —— 右上角导航：改用图标 ——
// icon 存 SVG 内层标记（stroke 用 currentColor，随主题与 hover 变色）
const icons: Record<string, string> = {
  home: '<path d="M3 9.5 12 2l9 7.5"/><path d="M5 9v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M9.5 22v-6h5v6"/>',
  tags: '<path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.2" fill="currentColor" stroke="none"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/>',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
};

const nav = [
  { href: '/', label: '首页', icon: 'home', external: false },
  { href: '/tags/', label: '标签', icon: 'tags', external: false },
  { href: '/rss.xml', label: 'RSS', icon: 'rss', external: false },
  { href: 'https://github.com/na57/na57.github.io', label: 'GitHub', icon: 'github', external: true },
];
---

<header class="site-header">
  <a class="brand" href="/">na57.log</a>
  <nav>
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-label={item.label}
          title={item.label}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[item.icon]}
          />
        </a>
      ))
    }
  </nav>
</header>
