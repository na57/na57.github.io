---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="nagu.cc" description="一个用 Astro 构建的纯静态技术博客">
  <p class="intro">这里是 nagu.cc，一个纯静态维护的技术博客。</p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toISOString().slice(0, 10)}
          </time>
          {post.data.description && <p class="excerpt">{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((t) => (
                <li>
                  <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                    {t}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
