---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 按 年 → 月 分组
const byYear = new Map<number, Map<number, typeof allPosts>>();
for (const p of allPosts) {
  const d = p.data.date;
  const y = d.getFullYear();
  const m = d.getMonth() + 1;
  if (!byYear.has(y)) byYear.set(y, new Map());
  const mm = byYear.get(y)!;
  if (!mm.has(m)) mm.set(m, []);
  mm.get(m)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="nagu.cc" description="一个用 Astro 构建的纯静态技术博客">
  <div class="home">
    <div class="home-main">
      <p class="intro">这里是 nagu.cc，一个纯静态维护的技术博客。</p>

      {
        years.map((y) => (
          <section class="year-group">
            <h2 class="year-head">{y} 年</h2>
            {[...byYear.get(y)!.keys()]
              .sort((a, b) => b - a)
              .map((m) => (
                <div class="month-group">
                  <h3 class="month-head">{m} 月</h3>
                  <ul class="post-list">
                    {byYear.get(y)!.get(m)!.map((post) => (
                      <li>
                        <h2>
                          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                        </h2>
                        <time datetime={post.data.date.toISOString()}>
                          {post.data.date.toISOString().slice(0, 10)}
                        </time>
                        {post.data.description && (
                          <p class="excerpt">{post.data.description}</p>
                        )}
                        {post.data.tags.length > 0 && (
                          <ul class="tags">
                            {post.data.tags.map((t) => (
                              <li>
                                <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                                  {t}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
          </section>
        ))
      }
    </div>

    <Sidebar />
  </div>
</BaseLayout>
