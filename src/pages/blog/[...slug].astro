---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const target = post.data.redirect;
const isRedirect = Boolean(target);
const { Content } = isRedirect ? { Content: null } : await render(post);

// 链接型文章：用 JS 模板字符串拼出整页 HTML（避免在 JSX 属性里插值失败），再 set:html 输出。
// 静态托管下以 meta refresh 即时跳转，JS 作为即时跳转的兜底。
const redirectHtml = isRedirect
  ? `<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=${target}">
<title>${post.data.title}</title>
</head>
<body>
<p>正在跳转到原文：<a href="${target}">${target}</a></p>
<script>window.location.replace(${JSON.stringify(target)});</script>
</body>
</html>`
  : '';
---

{
  isRedirect ? (
    <Fragment set:html={redirectHtml} />
  ) : (
    <BaseLayout
      title={post.data.title}
      description={post.data.description ?? ''}
      ogType="article"
    >
      <article class="post">
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toISOString().slice(0, 10)}
          </time>
          {
            post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((t) => (
                  <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                    {t}
                  </a>
                ))}
              </span>
            )
          }
        </div>
        <div class="prose">
          <Content />
        </div>
        <Comments />
      </article>
    </BaseLayout>
  )
}
