---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courses } from '../data/lectures';

const total = courses.reduce((a, c) => a + c.chapters.length, 0);
---

<BaseLayout
  title="互动讲义 · na57.log"
  description={`${total} 章互动讲义：概念卡 + 分层习题 + 复习计划，配套可离线播放的 HTML 课件`}
>
  <div class="lectures">
    <header class="lectures-hero">
      <h1>互动讲义</h1>
      <p class="tagline">
        书能看懂、过后就忘、章节之间串不起来——这套讲义为解决这个问题而生：每章拆成概念卡、分层习题和复习计划，再配一份可离线播放的 HTML 课件，把「读过」变成「记住」。
      </p>
      <p class="stats">{courses.length} 门课程 · {total} 章讲义</p>
    </header>

    <div class="course-grid">
      {
        courses.map((c) => (
          <section class="course-card" style={`--course: ${c.color}`}>
            <div class="course-head">
              <h2 class="course-name">{c.name}</h2>
              <p class="course-book">{c.book}</p>
              <p class="course-desc">{c.desc}</p>
              <div class="course-meta">
                <span class="course-count">{c.chapters.length} 章</span>
                {c.slidesDir && <span class="course-count">配套课件</span>}
              </div>
              <a class="enter-btn" href={`/${c.slug}/`}>进入讲义</a>
            </div>
            <details class="chapter-panel">
              <summary>
                章节目录
                <span class="chevron" aria-hidden="true">▾</span>
              </summary>
              <ul class="chapter-list">
                {c.chapters.map((ch) => (
                  <li class="chapter-row">
                    <span class="chapter-title">
                      第 {ch.no} 章 · {ch.title}
                    </span>
                    <span class="chapter-links">
                      <a href={`/${c.slug}/${ch.file}`}>讲义</a>
                      {ch.slide && c.slidesDir && (
                        <a
                          href={`/${c.slidesDir}/${encodeURIComponent(ch.slide)}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          课件
                        </a>
                      )}
                      {ch.video && (
                        <a
                          class="video-badge"
                          href={`/${c.slug}/${ch.file}#video-card`}
                          title={`章内观看视频（B 站 ${ch.video.bvid}）`}
                        >
                          ▶ 视频
                        </a>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </details>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .lectures {
    margin-top: 2rem;
  }
  .lectures-hero h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .tagline {
    color: var(--muted);
    max-width: 46rem;
    margin: 0;
  }
  .stats {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.75rem 0 0;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .course-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-top: 3px solid var(--course);
    border-radius: 12px;
    background: color-mix(in srgb, var(--code-bg) 55%, var(--bg));
    padding: 1.25rem 1.25rem 0.9rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .course-card:hover {
    transform: translateY(-3px);
    border-color: var(--course);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--course) 22%, transparent);
  }
  .course-name {
    margin: 0;
    font-size: 1.35rem;
  }
  .course-book {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .course-desc {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }
  .course-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }
  .course-count {
    font-size: 0.78rem;
    color: var(--course);
    background: color-mix(in srgb, var(--course) 12%, transparent);
    border-radius: 1rem;
    padding: 0.1rem 0.6rem;
  }
  .enter-btn {
    display: inline-block;
    align-self: flex-start;
    margin-top: 0.9rem;
    padding: 0.4rem 1.2rem;
    border-radius: 8px;
    font-weight: 600;
    color: #fff;
    background: var(--course);
    transition: filter 0.15s ease;
  }
  .enter-btn:hover {
    filter: brightness(1.1);
    text-decoration: none;
  }

  .chapter-panel {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
  }
  .chapter-panel summary {
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--muted);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0;
  }
  .chapter-panel summary::-webkit-details-marker {
    display: none;
  }
  .chapter-panel summary:hover {
    color: var(--fg);
  }
  .chapter-panel .chevron {
    transition: transform 0.15s ease;
  }
  .chapter-panel[open] .chevron {
    transform: rotate(180deg);
  }
  .chapter-list {
    list-style: none;
    margin: 0.4rem 0 0.2rem;
    padding: 0;
  }
  .chapter-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.3rem 0;
    font-size: 0.88rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--border) 55%, transparent);
  }
  .chapter-row:last-child {
    border-bottom: none;
  }
  .chapter-title {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .chapter-links {
    flex-shrink: 0;
    display: flex;
    gap: 0.7rem;
    font-size: 0.82rem;
  }
  .chapter-links a {
    color: var(--course);
  }
  .chapter-links .video-badge {
    color: #fff;
    background: var(--course);
    border-radius: 1rem;
    padding: 0 0.55rem;
    font-size: 0.76rem;
    line-height: 1.5;
    white-space: nowrap;
  }
  .chapter-links .video-badge:hover {
    filter: brightness(1.12);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .course-grid {
      grid-template-columns: 1fr;
    }
    .lectures-hero h1 {
      font-size: 1.6rem;
    }
  }
</style>
