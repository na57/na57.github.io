---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

export async function getStaticPaths({ paginate }) {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return paginate(allPosts, { pageSize: 10 });
}

const { page } = Astro.props;
const posts = page.data;
const totalPages = page.lastPage;
const cur = page.currentPage;
// 目录索引式页面，URL 带尾斜杠（/2/），与全站 /blog/<slug>/ 约定一致，避免 GitHub Pages 上 /2 404
const hrefFor = (p: number) => (p === 1 ? '/' : `/${p}/`);
const pageNums = Array.from({ length: totalPages }, (_, i) => i + 1);
// 页码过多时只显示当前页附近的窗口，避免首页底部页码爆炸
const WINDOW = 2;
const visible: number[] = pageNums.filter(
  (p) => p === 1 || p === totalPages || Math.abs(p - cur) <= WINDOW
);
// 补上省略号占位（用 0 表示 «）
const items: number[] = [];
let prev = 0;
for (const p of visible) {
  if (prev && p - prev > 1) items.push(0);
  items.push(p);
  prev = p;
}
---

<BaseLayout
  title="na57.log"
  description="na57 的技术札记 —— 数据治理、AI、安全，以及家乡的人和事。"
>
  <div class="home">
    <div class="home-main">
      <p class="intro">na57 的技术札记 —— 数据治理、AI、安全，以及家乡的人和事。</p>

      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              {post.data.description && (
                <p class="excerpt">{post.data.description}</p>
              )}
              {post.data.tags.length > 0 && (
                <ul class="tags">
                  {post.data.tags.map((t) => (
                    <li>
                      <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                        {t}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      {
        totalPages > 1 && (
          <nav class="pagination" aria-label="分页导航">
            {cur > 1 ? (
              <a class="page-nav" href={hrefFor(cur - 1)} rel="prev">
                ← 上一页
              </a>
            ) : (
              <span class="page-nav disabled">← 上一页</span>
            )}
            {items.map((p) =>
              p === 0 ? (
                <span class="page-ellipsis">…</span>
              ) : p === cur ? (
                <span class="page-num active" aria-current="page">
                  {p}
                </span>
              ) : (
                <a class="page-num" href={hrefFor(p)}>
                  {p}
                </a>
              )
            )}
            {cur < totalPages ? (
              <a class="page-nav" href={hrefFor(cur + 1)} rel="next">
                下一页 →
              </a>
            ) : (
              <span class="page-nav disabled">下一页 →</span>
            )}
          </nav>
        )
      }
    </div>

    <Sidebar />
  </div>
</BaseLayout>
